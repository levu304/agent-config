{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "edit",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "glob",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "grep",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "git status *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "git log *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "sleep *",
      "effect": "deny",
    },
    {
      "action": "shell",
      "resource": "perl *",
      "effect": "deny",
    },
    {
      "action": "shell",
      "resource": "awk *",
      "effect": "deny",
    },
    {
      "action": "subagent",
      "resource": "*",
      "effect": "deny",
    },
    {
      "action": "question",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "skill",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "*",
      "effect": "deny",
    },
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow",
    },
    {
      "action": "<server>_<tool>",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "opencode_list_mcp_resources",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "opencode_read_mcp_resource",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "webfetch",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "websearch",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "execute",
      "resource": "*",
      "effect": "ask",
    },
  ],
  "agents": {
    "compaction": { "model": "opencode-go/muse-spark-1.3-contributor" },
    "title": { "model": "opencode-go/muse-spark-1.3-contributor#minimal" },
    "meta-orchestrator": {
      "permissions": [
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "webfetch",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "websearch",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "skill",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "skill",
          "resource": "delegate-subagent",
          "effect": "allow",
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "allow",
        },
      ],
    },
    "spec-architect": {
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "edit",
          "resource": "openspec/*",
          "effect": "allow",
        },
        {
          "action": "execute",
          "resource": "*",
          "effect": "ask",
        },
        {
          "action": "skill",
          "resource": "delegate-subagent",
          "effect": "allow",
        },
        {
          "action": "subagent",
          "resource": "explore",
          "effect": "allow",
        },
        {
          "action": "subagent",
          "resource": "technical-writer",
          "effect": "allow",
        },
        {
          "action": "shell",
          "resource": "node *",
          "effect": "deny",
        },
        {
          "action": "shell",
          "resource": "python3 *",
          "effect": "deny",
        },
      ],
    },
    "research-analyst": {
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "skill",
          "resource": "delegate-subagent",
          "effect": "allow",
        },
        {
          "action": "subagent",
          "resource": "explore",
          "effect": "allow",
        },
        {
          "action": "subagent",
          "resource": "technical-writer",
          "effect": "allow",
        },
      ],
    },
    "technical-writer": {
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "edit",
          "resource": "**/*.md",
          "effect": "allow",
        },
      ],
    },
    "error-detective": {
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "skill",
          "resource": "delegate-subagent",
          "effect": "allow",
        },
        {
          "action": "subagent",
          "resource": "explore",
          "effect": "allow",
        },
        {
          "action": "subagent",
          "resource": "technical-writer",
          "effect": "allow",
        },
        {
          "action": "subagent",
          "resource": "debugger",
          "effect": "allow",
        },
      ],
    },
    "code-reviewer": {
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "skill",
          "resource": "delegate-subagent",
          "effect": "allow",
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "ask",
        },
        {
          "action": "subagent",
          "resource": "technical-writer",
          "effect": "allow",
        },
      ],
    },
    "bug-hunter": {
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny",
        },
        {
          "action": "skill",
          "resource": "delegate-subagent",
          "effect": "allow",
        },
        {
          "action": "subagent",
          "resource": "technical-writer",
          "effect": "allow",
        },
      ],
    },
    "debugger": {
      "permissions": [
        {
          "action": "skill",
          "resource": "delegate-subagent",
          "effect": "allow",
        },
        {
          "action": "subagent",
          "resource": "technical-writer",
          "effect": "allow",
        },
      ],
    },
  },
  "mcp": {
    "timeout": {
      "startup": 45000,
      "catalog": 30000,
      "execution": 600000,
    },
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
      },
      "prompts.chat": {
        "type": "remote",
        "url": "https://prompts.chat/api/mcp",
      },
      "gh_grep": {
        "type": "remote",
        "url": "https://mcp.grep.app",
      },
      "gitnexus": {
        "type": "local",
        "command": ["gitnexus", "mcp"],
      },
      "sequential-thinking": {
        "type": "local",
        "command": [
          "bunx",
          "@modelcontextprotocol/server-sequential-thinking",
        ],
      },
      "serena": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "serena-agent",
          "serena",
          "start-mcp-server",
          "--project-from-cwd",
          "--context",
          "agent",
          "--open-web-dashboard",
          "False",
        ],
      },
      "context-mode": {
        "type": "local",
        "command": ["context-mode"],
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "bunx",
          "chrome-devtools-mcp@latest",
          "--slim",
          "--headless",
        ],
      },
      "firefox-devtools": {
        "type": "local",
        "command": [
          "bunx",
          "@mozilla/firefox-devtools-mcp@latest",
          "--headless",
          "--tool-preset developer"
        ],
      },
    },
  },
  "plugins": ["opencode-cmd-provider@2.2.11", "@dietrichgebert/ponytail"],
}
